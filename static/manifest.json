{
  "manifest_version": 3,
  "name": "Merge Guard for GitHub",
  "version": "0.1.0",
  "description": "Stop accidental merge commits and rebases. Hide the merge, squash or rebase buttons on GitHub pull requests, per repo or org.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Merge Guard", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
